# Cadastre estes valores no painel Vercel, em Settings > Environment Variables.
# A publicacao funciona sem valores; a emissao permanece desativada ate configurar.
SGA_BASE_URL=
# Aceitar backend HTTP somente por escolha explicita. Exige o valor literal true.
# Nesse modo, credenciais/token trafegam sem criptografia entre Vercel e backend.
SGA_ALLOW_HTTP=false
SGA_CLIENT_ID=
SGA_CLIENT_SECRET=
SGA_USERNAME=totem
SGA_PASSWORD=
SGA_UNIT_ID=
SGA_SERVICE_ID=
SGA_NORMAL_PRIORITY_ID=
SGA_PRIORITY_ID=
# Codigo forte da equipe para autorizar este navegador. Pelo menos 16 caracteres.
KIOSK_ACCESS_CODE=
# Segredo aleatorio de pelo menos 32 caracteres; nao reutilize a senha de um usuario.
COOKIE_SECRET=
